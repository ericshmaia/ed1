/* 
1. Faça um programa em C que manipula dados de pessoas (nome, idade, cpf, rg, telefone).
Utilize struct para agrupar os dados. Além disso, faça uma função que recebe os dados via
teclado e armazena na strucyt. Faça uma outra função para imprimir os dados de uma struct pessoa.
*/

#include <stdio.h>
    
typedef struct {
    char nome[50];
    int idade;
    int cpf[20];
    int rg[20];
    int telefone[20];
} Pessoa;

void receberDados(Pessoa *p){
    printf("Insira seu nome: ");
    scanf(" %[^\n]", p->nome);

    printf("Insira sua idade: ");
    scanf("%d", &p->idade);

    printf("Insira seu cpf: ");
    scanf(" %[^\n]", p->cpf);

    printf("Insira seu rg: ");
    scanf(" %[^\n]", p->rg);

    printf("Insira seu telefone: ");
    scanf(" %[^\n]", p->telefone);
}

void imprimirDados(Pessoa p){
    printf("\n=== Dados Pessoais ===\n");
    printf("Nome: %s\n", p.nome);
    printf("Idade: %d anos\n", p.idade);
    printf("CPF: %s\n", p.cpf);
    printf("RG: %s\n", p.rg);
    printf("Telefone: %s\n", p.telefone);
}

int main(){
    Pessoa individuo;

    receberDados(&individuo);
    imprimirDados(individuo);

    return 0;
}